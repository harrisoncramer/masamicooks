---
import Header from "../components/Header.astro";

export interface Props {
  title: string;
  recipe?: boolean;
}

const { title, recipe } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{!recipe && "masamicooks - "}{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Masami Cookson's cooking blog." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://masamicooks.com`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:description" content="Masami Cookson's cooking blog." />
  </head>
  <body>
    <Header />
    <div class="mx-4 md:mx-8 flex justify-center">
      <slot />
    </div>
  </body>
</html>
<style is:global>
  @font-face {
    font-family: "Nugelo";
    src: url("/fonts/nugelo.otf");
  }

  *::selection {
    background-color: #d94030;
    color: #fff5e1;
  }

  * {
    scrollbar-width: thin;
    scrollbar-color: rgba(181, 69, 27, 0.3) transparent;
  }

  *::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }

  *::-webkit-scrollbar-track {
    background: transparent;
  }

  *::-webkit-scrollbar-thumb {
    background-color: rgba(181, 69, 27, 0.3);
    border-radius: 3px;
  }

  *::-webkit-scrollbar-thumb:hover {
    background-color: rgba(181, 69, 27, 0.5);
  }

  h2,
  h1 {
    font-family: "Nugelo";
  }

  h2 {
    @apply text-3xl text-app-rust;
  }

  html {
    @apply relative min-h-full;
    overflow-y: scroll;
  }

  body {
    @apply bg-app-background text-app-text mb-24 mt-24;
  }

  p {
    line-height: 1.8;
    margin-bottom: 1.25em;
    @apply text-app-text;
    font-size: 1.05rem;
    letter-spacing: 0.01em;
  }

  li {
    line-height: 1.75;
    @apply text-app-text;
  }

  small, time {
    @apply text-app-text-light;
  }

  a {
    @apply text-app-brown;
    transition: color 0.15s ease;
  }

  a:hover {
    @apply text-app-theme;
  }

  .nav-glow {
    box-shadow:
      inset 0 -30px 50px -10px rgba(217, 64, 48, 0.35),
      inset 0 15px 40px -5px rgba(200, 164, 21, 0.2),
      0 4px 16px rgba(92, 58, 33, 0.2);
  }

  img {
    border-radius: 6px;
  }

  .skeleton {
    animation: skeleton-loading 0.6s linear infinite alternate;
  }

  @keyframes skeleton-loading {
    0% {
      @apply bg-app-background-dark;
    }
    100% {
      background-color: #d4c8b0;
    }
  }

  hr {
    @apply border-app-border my-8;
  }

  blockquote {
    @apply border-l-4 border-app-mustard pl-4 italic text-app-text-light my-4;
  }

  footer {
    @apply absolute bottom-0 w-full flex justify-center text-app-muted py-8;
  }

  input[type="text"]:focus {
    @apply outline-app-theme;
    outline-style: solid;
    outline-width: 1px;
  }
</style>
