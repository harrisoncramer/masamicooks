---
interface Props {
  tags: Array<string>;
}

const { tags } = Astro.props;
---

<div class="flex flex-wrap gap-2 mt-2 justify-center">
  {
    tags.map((tag) => (
      <span class="inline-block py-1 px-3 text-sm rounded-full bg-app-mustard-light bg-opacity-30 text-app-brown border border-app-border">
        {tag}
      </span>
    ))
  }
</div>
