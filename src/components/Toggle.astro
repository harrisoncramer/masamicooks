<button
  type="button"
  class="toggle-btn relative flex h-10 w-10 items-center justify-center"
  aria-label="Menu"
  aria-expanded="false"
>
  <span class="toggle-line toggle-line-1"></span>
  <span class="toggle-line toggle-line-2"></span>
  <span class="toggle-line toggle-line-3"></span>
</button>
<slot />

<style is:global>
  .toggle-line {
    position: absolute;
    height: 2px;
    width: 20px;
    background-color: #5c3a21;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.15s;
  }

  .toggle-line-1 {
    transform: translateY(-6px);
  }

  .toggle-line-3 {
    transform: translateY(6px);
  }

  .toggle-btn[aria-expanded="true"] .toggle-line-1 {
    transform: rotate(45deg);
  }

  .toggle-btn[aria-expanded="true"] .toggle-line-2 {
    opacity: 0;
  }

  .toggle-btn[aria-expanded="true"] .toggle-line-3 {
    transform: rotate(-45deg);
  }

  .toggle-content {
    position: absolute;
    right: 0;
    top: 100%;
    background-color: #f8b591;
    padding: 0.5rem 0 0.75rem;
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition: clip-path 160ms cubic-bezier(0.7, 0, 0.84, 0), visibility 0s 160ms;
    list-style: none;
    min-width: 180px;
    text-align: left;
    border-radius: 0 0 6px 6px;
  }

  .toggle-content.open {
    clip-path: inset(0 0 -1rem 0);
    visibility: visible;
    transition: clip-path 220ms cubic-bezier(0.16, 1, 0.3, 1), visibility 0s;
  }

  @media (min-width: 768px) {
    .toggle-btn {
      display: none;
    }

    .toggle-content {
      position: static;
      clip-path: none !important;
      visibility: visible !important;
      display: flex !important;
      background: none;
      padding: 0;
    }
  }
</style>

<script>
  const btn = document.querySelector(".toggle-btn") as HTMLElement;
  const menu = document.querySelector(".toggle-content") as HTMLElement;

  if (btn && menu) {
    btn.addEventListener("click", () => {
      const open = menu.classList.toggle("open");
      btn.setAttribute("aria-expanded", String(open));
    });

    document.addEventListener("pointerdown", (e) => {
      if (e.target instanceof Node && !btn.contains(e.target) && !menu.contains(e.target)) {
        menu.classList.remove("open");
        btn.setAttribute("aria-expanded", "false");
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        menu.classList.remove("open");
        btn.setAttribute("aria-expanded", "false");
        btn.focus();
      }
    });
  }
</script>
