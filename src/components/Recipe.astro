---
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";
import type { Document } from "@contentful/rich-text-types";
import type { Asset } from "contentful";
import Tags from "./Tags.astro";
dayjs.extend(localizedFormat);

interface Props {
  title: string;
  content: Document;
  introduction: Document;
  mainImage: Asset;
  date: Date;
  categories: Array<string>;
  ingredients: Array<string>;
  optionalIngredients: Array<string>;
  slug: string;
}

const {
  title,
  date,
  categories,
  mainImage,
  ingredients,
  introduction,
  optionalIngredients,
  content,
} = Astro.props;
---

<body>
  <section class="max-w-3xl w-full m-auto px-4 mt-8 mb-12">
    <div class="text-center mb-8">
      <h1 class="font-display text-app-rust text-4xl lg:text-5xl mb-3">
        {title}
      </h1>
      <time class="font-sans block mb-3 text-app-muted">
        <small>{date}</small>
      </time>
      <Tags tags={categories} />
    </div>
    <div class="my-8 max-w-2xl m-auto">
      <img src={mainImage.fields.file?.url} class="w-full" />
    </div>
    <div set:html={introduction} class="text-lg mb-8" />
    <div class="md:grid grid-cols-12 gap-8">
      <div class="mb-8 md:mb-0 col-span-4">
        <h2 class="font-display text-2xl mb-3 text-app-rust">Ingredients</h2>
        <ul>
          {
            ingredients.map((ingredient) => (
              <li class="list-disc ml-4 mb-1">{ingredient}</li>
            ))
          }
        </ul>
        {
          optionalIngredients && (
            <div class="mt-6">
              <h2 class="font-display text-2xl mb-3 text-app-rust">
                Optional
              </h2>
              <ul>
                {optionalIngredients.map((ingredient) => (
                  <li class="list-disc ml-4 mb-1">{ingredient}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
      <div class="col-span-8">
        <h2 class="font-display text-2xl mb-3 text-app-rust">
          Instructions
        </h2>
        <article set:html={content} class="flex flex-col gap-4 text-lg" />
      </div>
    </div>
  </section>
</body>
