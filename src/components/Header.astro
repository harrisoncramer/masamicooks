---
import insta from "../images/insta.svg";
import HeaderLink from "./HeaderLink.astro";
import Toggle from "./Toggle.astro";
---

<div
  role="navigation"
  aria-label="Main"
  class="flex justify-between items-center px-6 py-2 fixed top-0 w-full h-16 z-20 bg-app-header nav-glow"
>
  <div class="flex items-center gap-3">
    <a href="https://instagram.com/masamicooks" class="flex items-center leading-none">
      <img height="18" width="18" src={insta} class="block" />
    </a>
    <a href="/" class="flex items-center leading-none">
      <h1 class="text-xl md:text-2xl text-app-brown m-0 p-0 leading-none">MasamiCooks</h1>
    </a>
  </div>

  <div class="hidden md:flex items-center">
    <HeaderLink displayName="About" path="about" />
    <HeaderLink displayName="Recipes" path="" />
    <HeaderLink displayName="Blog" path="blog" />
  </div>

  <div class="relative md:hidden">
    <Toggle>
      <ul class="toggle-content">
        <HeaderLink displayName="About" path="about" />
        <HeaderLink displayName="Recipes" path="" />
        <HeaderLink displayName="Blog" path="blog" />
      </ul>
    </Toggle>
  </div>
</div>
