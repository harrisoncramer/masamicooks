---
import { Image } from "@astrojs/image/components";
import { contentfulClient } from "../lib/contentful";
import type { Document } from "@contentful/rich-text-types";
import type { Asset } from "contentful";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";
import Layout from "../layouts/Layout.astro";
dayjs.extend(localizedFormat);

interface Recipe {
  title: string;
  content: Document;
  mainImage: Asset;
  date: Date;
  slug: string;
  categories: Array<string>;
  ingredients: Array<string>;
  optionalIngredients: Array<string>;
}

const entries = await contentfulClient.getEntries<Recipe>({
  content_type: "recipe",
});

const items = entries.items.map(({ fields }) => {
  return {
    ...fields,
    date: dayjs(fields.date).format("LL"),
  };
});
---

<Layout title="home">
  <div
    class="grid-wrapper grid pt-6 gap-6 gap-y-8 lg:grid-cols-3 md:grid-cols-3 sm:grid-cols-2 max-w-max m-auto"
  >
    {
      items.map(({ title, mainImage, slug }) => {
        return (
          <div>
            <a href={`/recipe/${slug}`}>
              <div class="relative group h-full overflow-hidden rounded-md">
                {mainImage.fields.file?.url && (
                  <Image
                    height={420}
                    aspectRatio={1}
                    alt={title}
                    src={mainImage.fields.file?.url}
                    class="md:hover:cursor-pointer transition-all duration-300 md:group-hover:scale-105 md:group-hover:brightness-110 w-full object-cover h-full"
                  />
                )}
              </div>
            </a>
          </div>
        );
      })
    }
  </div>
</Layout>
<style>
  .grid-wrapper {
    max-width: 80em;
  }

  .grid-wrapper > div {
    max-height: 410px;
    overflow: hidden;
    border-radius: 6px;
    transition: box-shadow 0.2s ease;
  }

  .grid-wrapper > div:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
  }
</style>
