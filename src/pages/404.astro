---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found">
  <div class="mt-8 flex flex-col gap-4 max-w-3xl m-auto px-4">
    <h1 class="text-3xl text-app-rust">Page not found</h1>
    <p>
      There's nothing at this address. The link may be out of date, or the page
      may have moved.
    </p>
    <p>
      Head back to the <a href="/">home page</a>, browse
      <a href="/recipes">recipes</a>, or check out the <a href="/blog">blog</a>.
    </p>
  </div>
</Layout>
